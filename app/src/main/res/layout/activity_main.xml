<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Главный экран -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Верхняя шапка -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/card_dark"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/primary_orange" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/primary_orange"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Помогатор Строителя"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Профессиональный расчёт"
                    android:textColor="@color/text_orange"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:backgroundTint="@color/primary_orange"
                android:src="@android:drawable/ic_menu_share"
                app:tint="@color/text_white" />
        </LinearLayout>

        <!-- Контейнер карточки калькулятора -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottomNav"
            android:layout_below="@id/topBar"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/calculatorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_dark"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Заголовок калькулятора -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/calcIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@color/primary_orange"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/calcTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Шпаклёвка"
                            android:textColor="@color/text_white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/calcSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Расчёт расхода шпаклёвки по типу смеси и площади"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#222B3D"/>

                <!-- Поле 1: Выбор типа -->
                <TextView
                    android:id="@+id/lblParam1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Вид шпаклёвки"
                    android:textColor="@color/text_white"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/input_dark" />

                <!-- Поле 2: Площадь -->
                <TextView
                    android:id="@+id/lblParam2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Площадь стен (м²)"
                    android:textColor="@color/text_white"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputArea"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/input_dark"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="25"
                    android:textColor="@color/text_white" />

                <!-- Поле 3: Толщина слоя -->
                <TextView
                    android:id="@+id/lblParam3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Толщина слоя (мм)"
                    android:textColor="@color/text_white"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputThickness"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/input_dark"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="2"
                    android:textColor="@color/text_white" />

                <!-- Поле 4: Вес мешка -->
                <TextView
                    android:id="@+id/lblParam4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Вес мешка (кг)"
                    android:textColor="@color/text_white"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputBagWeight"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/input_dark"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="20"
                    android:textColor="@color/text_white" />

                <!-- Кнопка Расчёт -->
                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/primary_orange"
                    android:text="Рассчитать"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Поле Результат -->
                <TextView
                    android:id="@+id/txtResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="@color/text_orange"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Нижняя навигация -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:background="@color/card_dark"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@color/primary_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Домой"
                    android:textColor="@color/primary_orange"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAbout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="@color/text_gray" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="О нас"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navContacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="@color/text_gray" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Контакты"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPrivacy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@color/text_gray" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Приваси"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Выдвижное боковое меню (Drawer) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/card_dark">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Калькуляторы"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Список калькуляторов -->
                <Button android:id="@+id/menuPutty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Шпаклёвка" android:backgroundTint="@color/primary_orange" android:textColor="@color/text_white" android:layout_marginTop="8dp"/>
                <Button android:id="@+id/menuWallpaper" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Обои по стенам" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/menuPaint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Краска (все виды)" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/menuColoring" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Колеровка" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/menuCement" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Цемент и песок" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/menuPlaster" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Декоративная штукатурка" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/menuPenoplex" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Обшивка пеноплексом" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/menuPvc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ПВХ панели" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/menuFloorTile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Напольная плитка" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/menuMasonry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Кладка блоков и кирпича" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/menuCeilingTile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Потолочная плитка" android:backgroundTint="@color/input_dark" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222B3D" android:layout_marginVertical="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="НАСТРОЙКИ"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <!-- Переключатель тёмного режима -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Тёмный режим" android:textColor="@color/text_white"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

                <!-- Выбор языка -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Язык интерфейса"
                    android:textColor="@color/text_white" />

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/input_dark" />
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
