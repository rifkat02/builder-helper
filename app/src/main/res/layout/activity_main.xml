<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F2FE"> <!-- Светло-синий фон -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Верхняя шапка -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#BAE6FD"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#0369A1" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/app_icon"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Помогатор Строителя"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Профессиональный расчёт"
                    android:textColor="#0284C7"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_share"
                app:tint="#0369A1" />
        </LinearLayout>

        <!-- Контейнер карточки -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottomNav"
            android:layout_below="@id/topBar"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/calculatorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/calcIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#0284C7"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/calcTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Шпаклёвка"
                            android:textColor="#0F172A"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/calcSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Расчёт расхода шпаклёвки по типу смеси и площади"
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#E2E8F0"/>

                <TextView
                    android:id="@+id/lblParam1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Вид шпаклёвки"
                    android:textColor="#0F172A"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#F1F5F9" />

                <TextView
                    android:id="@+id/lblParam2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Площадь стен (м²)"
                    android:textColor="#0F172A"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputArea"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#F1F5F9"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="25"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblParam3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Толщина слоя (мм)"
                    android:textColor="#0F172A"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputThickness"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#F1F5F9"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="2"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblParam4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Вес мешка (кг)"
                    android:textColor="#0F172A"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputBagWeight"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#F1F5F9"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="20"
                    android:textColor="#0F172A" />

                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#0284C7"
                    android:text="Рассчитать"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="#0369A1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Нижняя навигация -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:background="#BAE6FD"
            android:orientation="horizontal"
            android:elevation="4dp">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="#0284C7" />

                <TextView
                    android:id="@+id/txtNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Домой"
                    android:textColor="#0284C7"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAbout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/txtNavAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="О нас"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navContacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/txtNavContacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Контакты"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPrivacy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/txtNavPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Приваси"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Боковое меню с кнопкой смены темы внизу и полным переводом -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtMenuHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Калькуляторы"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button android:id="@+id/menuPutty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Шпаклёвка" android:backgroundTint="#0284C7" android:textColor="#FFFFFF" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuWallpaper" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Обои по стенам" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuPaint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Краска (все виды)" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuColoring" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Колеровка" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuCement" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Цемент и песок" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuPlaster" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Декоративная штукатурка" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuPenoplex" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Обшивка пеноплексом" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuPvc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ПВХ панели" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuFloorTile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Напольная плитка" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuMasonry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Кладка блоков и кирпича" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuCeilingTile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Потолочная плитка" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuPlinth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Плинтус" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/menuSelfLeveling" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Наливной пол / Стяжка" android:backgroundTint="#F1F5F9" android:textColor="#0F172A" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </ScrollView>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0" android:layout_marginVertical="12dp"/>

            <!-- Нижняя часть меню: Язык и Кнопка Светлого режима -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSettingsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="НАСТРОЙКИ"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtLangLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Язык интерфейса"
                    android:textColor="#0F172A" />

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="#F1F5F9" />

                <!-- Кнопка переключения светлого/темного режима внизу меню -->
                <Button
                    android:id="@+id/btnToggleTheme"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#E2E8F0"
                    android:text="Светлая тема"
                    android:textColor="#0F172A"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
